+use anyhow::{Result, ensure};
+use serde::{Deserialize, Serialize};
+use std::sync::OnceLock;
+
+#[derive(Clone, Copy, Debug, Default, Deserialize, PartialEq, Serialize)]
+#[serde(rename_all = "kebab-case")]
+pub enum Mode {
+    #[default]
+    Baseline,
+    LossOnly,
+    LossOnlyNoCrc,
+    CacheOnly,
+}
+static MODE: OnceLock<Mode> = OnceLock::new();
+static VECTORED: OnceLock<bool> = OnceLock::new();
+pub fn init() -> Result<()> {
+    let mode = match std::env::var("RECORDER_ABLATION").as_deref() {
+        Err(std::env::VarError::NotPresent) | Ok("baseline") => Mode::Baseline,
+        Ok("loss-only") => Mode::LossOnly,
+        Ok("loss-only-no-crc") => Mode::LossOnlyNoCrc,
+        Ok("cache-only") => Mode::CacheOnly,
+        _ => anyhow::bail!("invalid experimental integrity mode"),
+    };
+    let io = std::env::var("RECORDER_ABLATION_IO");
+    ensure!(
+        matches!(
+            io.as_deref(),
+            Err(std::env::VarError::NotPresent) | Ok("split" | "pwritev")
+        ),
+        "invalid experimental I/O mode"
+    );
+    let _ = MODE.set(mode);
+    let _ = VECTORED.set(io.as_deref() == Ok("pwritev"));
+    Ok(())
+}
+pub fn mode() -> Mode {
+    *MODE.get().unwrap_or(&Mode::Baseline)
+}
+pub fn full_journal() -> bool {
+    mode() == Mode::Baseline
+}
+pub fn data_crc() -> bool {
+    mode() != Mode::LossOnlyNoCrc
+}
+pub fn no_sync() -> bool {
+    mode() == Mode::CacheOnly
+}
+pub fn vectored() -> bool {
+    *VECTORED.get().unwrap_or(&false)
+}
