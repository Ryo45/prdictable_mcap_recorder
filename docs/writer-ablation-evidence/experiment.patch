@@ -0,0 +1,27 @@
+use std::hint::black_box;
+use std::time::Instant;
+
+#[test]
+#[ignore = "opt-in CRC microbenchmark; run in release"]
+fn payload_crc_bandwidth() {
+    let frame = 1 << 20;
+    let buffer = vec![0xef_u8; 64 * frame];
+    for trial in 1..=3 {
+        let wall = Instant::now();
+        let cpu = rustix::time::clock_gettime(rustix::time::ClockId::ThreadCPUTime);
+        let mut hash = crc32fast::Hasher::new();
+        for _ in 0..8 {
+            for payload in buffer.chunks_exact(frame) {
+                hash.update(black_box(payload));
+            }
+        }
+        let cpu_end = rustix::time::clock_gettime(rustix::time::ClockId::ThreadCPUTime);
+        let cpu_ns = (cpu_end.tv_sec - cpu.tv_sec) * 1_000_000_000 + cpu_end.tv_nsec - cpu.tv_nsec;
+        println!(
+            "CRC {trial} {} {} {cpu_ns} {}",
+            8 * buffer.len(),
+            wall.elapsed().as_nanos(),
+            black_box(hash.finalize())
+        );
+    }
+}
