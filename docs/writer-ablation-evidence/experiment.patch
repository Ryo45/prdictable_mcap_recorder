+#[derive(Default)]
+pub(super) struct Cost {
+    count: u64,
+    total_ns: u64,
+    max_ns: u64,
+    histogram: Option<Box<crate::metrics::Histogram>>,
+}
+
+impl Cost {
+    pub(super) fn add(&mut self, time: u64) {
+        self.histogram.get_or_insert_with(Box::default).record(time);
+        self.count += 1;
+        self.total_ns += time;
+        self.max_ns = self.max_ns.max(time);
+    }
+}
+
+impl Serialize for Cost {
+    fn serialize<S: serde::Serializer>(&self, serializer: S) -> Result<S::Ok, S::Error> {
+        use serde::ser::SerializeStruct;
+        let mut row = serializer.serialize_struct("Cost", 3)?;
+        row.serialize_field("total_ns", &self.total_ns)?;
+        row.serialize_field("max_ns", &self.max_ns)?;
+        let latency = self.histogram.as_ref().map(|histogram| histogram.summary());
+        row.serialize_field("latency", &latency)?;
+        row.end()
+    }
+}
