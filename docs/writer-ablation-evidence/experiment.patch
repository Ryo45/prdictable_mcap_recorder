+
+fn write_vec_all(
+    mut header: &[u8],
+    mut payload: &[u8],
+    mut offset: u64,
+    cap: Option<usize>,
+    mut write: impl FnMut(&[io::IoSlice<'_>], u64) -> io::Result<usize>,
+) -> io::Result<()> {
+    let cap = cap.unwrap_or(usize::MAX);
+    while !header.is_empty() || !payload.is_empty() {
+        let header_len = header.len().min(cap);
+        let payload_len = payload.len().min(cap - header_len);
+        let slices = [
+            io::IoSlice::new(&header[..header_len]),
+            io::IoSlice::new(&payload[..payload_len]),
+        ];
+        let parts = if header_len == 0 {
+            &slices[1..]
+        } else if payload_len == 0 {
+            &slices[..1]
+        } else {
+            &slices[..]
+        };
+        let n = match write(parts, offset) {
+            Ok(0) => return Err(io::ErrorKind::WriteZero.into()),
+            Ok(n) if n <= header_len + payload_len => n,
+            Ok(_) => return Err(io::ErrorKind::InvalidData.into()),
+            Err(err) if err.kind() == io::ErrorKind::Interrupted => continue,
+            Err(err) => return Err(err),
+        };
+        payload = &payload[n.saturating_sub(header.len())..];
+        header = &header[n.min(header.len())..];
+        offset = offset
+            .checked_add(n as u64)
+            .ok_or(io::ErrorKind::InvalidInput)?;
+    }
+    Ok(())
+}
