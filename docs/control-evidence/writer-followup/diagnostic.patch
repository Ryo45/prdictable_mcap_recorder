+#[derive(Default, Serialize)]
+pub(super) struct Cost {
+    count: u64,
+    total_ns: u64,
+    max_ns: u64,
+}
+
+impl Cost {
+    pub(super) fn add(&mut self, time: u64) {
+        self.count += 1;
+        self.total_ns += time;
+        self.max_ns = self.max_ns.max(time);
+    }
+}
+
+#[derive(Default, Serialize)]
+pub(super) struct Profile {
+    message_layout: Cost,
+    payload_and_header_crc: Cost,
+    io_submit_call: Cost,
+    completion_poll_call: Cost,
+    sync_completion_delivery: Cost,
+    async_queue_wait_with_inflight: Cost,
+    writer_queue_residence: Cost,
+    writer_idle_queue_wait: Cost,
+    queue_claim_mutex_wait: Cost,
+    data_sync_call: Cost,
+}
+
+fn time_if(enabled: bool, cost: &mut Cost, start: Option<Instant>) {
+    if enabled {
+        cost.add(ns(start.unwrap().elapsed()));
+    }
+}
